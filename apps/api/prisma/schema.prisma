generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  active
  disabled
}

enum ProjectRole {
  owner
  admin
  editor
  viewer
}

enum ActorType {
  member
  platform_admin
  system
}

model Tenant {
  id        String       @id @default(uuid()) @db.Uuid
  name      String
  slug      String       @unique
  status    TenantStatus @default(active)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  members   Member[]
  projects  Project[]

  @@map("tenants")
}

model Member {
  id            String          @id @default(uuid()) @db.Uuid
  tenantId      String          @map("tenant_id") @db.Uuid
  email         String
  passwordHash  String          @map("password_hash")
  displayName   String          @map("display_name")
  isTenantOwner Boolean         @default(false) @map("is_tenant_owner")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectMembers ProjectMember[]
  sessions      Session[]

  @@unique([tenantId, email])
  @@map("members")
}

model PlatformAdmin {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String    @map("password_hash")
  createdAt    DateTime  @default(now()) @map("created_at")
  sessions     Session[]

  @@map("platform_admins")
}

model Project {
  id        String          @id @default(uuid()) @db.Uuid
  tenantId  String          @map("tenant_id") @db.Uuid
  name      String
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members   ProjectMember[]
  assets    Asset[]
  venues    Venue[]

  @@index([tenantId])
  @@map("projects")
}

model ProjectMember {
  id        String      @id @default(uuid()) @db.Uuid
  projectId String      @map("project_id") @db.Uuid
  memberId  String      @map("member_id") @db.Uuid
  role      ProjectRole
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  member    Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([projectId, memberId])
  @@map("project_members")
}

model Session {
  id              String          @id @default(uuid()) @db.Uuid
  tokenHash       String          @unique @map("token_hash")
  memberId        String?         @map("member_id") @db.Uuid
  platformAdminId String?         @map("platform_admin_id") @db.Uuid
  expiresAt       DateTime        @map("expires_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  member          Member?         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  platformAdmin   PlatformAdmin?  @relation(fields: [platformAdminId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model AuditLog {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String?   @map("tenant_id") @db.Uuid
  actorType    ActorType @map("actor_type")
  actorId      String?   @map("actor_id") @db.Uuid
  action       String
  resourceType String    @map("resource_type")
  resourceId   String    @map("resource_id")
  metaJson     Json      @default("{}") @map("meta_json")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("audit_logs")
}

enum AssetKind {
  panorama_image
  panorama_video
  scene_package
  audio
  other
}

enum VenueStatus {
  draft
}

enum TrackKind {
  panorama
  scene3d
}

model Asset {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  projectId  String    @map("project_id") @db.Uuid
  kind       AssetKind
  title      String
  storageKey String    @map("storage_key")
  mime       String
  byteSize   BigInt    @map("byte_size")
  sha256     String
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  coverVenues Venue[]  @relation("VenueCover")
  entryTracks VenueTrack[] @relation("TrackEntry")

  @@index([projectId])
  @@index([sha256])
  @@map("assets")
}

model Venue {
  id           String       @id @default(uuid()) @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  projectId    String       @map("project_id") @db.Uuid
  title        String
  coverAssetId String?      @map("cover_asset_id") @db.Uuid
  primaryTrackId String?    @map("primary_track_id") @db.Uuid
  status       VenueStatus  @default(draft)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  coverAsset   Asset?       @relation("VenueCover", fields: [coverAssetId], references: [id], onDelete: SetNull)
  tracks       VenueTrack[]
  hotspots     Hotspot[]
  tours        Tour[]
  publications Publication[]

  @@index([projectId])
  @@map("venues")
}

enum PublicationStatus {
  published
  unpublished
}

model Publication {
  id             String            @id @default(uuid()) @db.Uuid
  tenantId       String            @map("tenant_id") @db.Uuid
  venueId        String            @map("venue_id") @db.Uuid
  publicId       String            @unique @map("public_id")
  status         PublicationStatus
  snapshot       Json
  version        Int
  publishedAt    DateTime?         @map("published_at")
  unpublishedAt  DateTime?         @map("unpublished_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  venue          Venue             @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId, version])
  @@map("publications")
}

model VenueTrack {
  id           String    @id @default(uuid()) @db.Uuid
  venueId      String    @map("venue_id") @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  trackKind    TrackKind @map("track_kind")
  title        String
  sortOrder    Int       @default(0) @map("sort_order")
  isPrimary    Boolean   @default(false) @map("is_primary")
  entryAssetId String?   @map("entry_asset_id") @db.Uuid
  configJson   Json      @default("{}") @map("config_json")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  venue        Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  entryAsset   Asset?    @relation("TrackEntry", fields: [entryAssetId], references: [id], onDelete: SetNull)
  hotspots     Hotspot[]
  tours        Tour[]

  @@index([venueId, sortOrder])
  @@map("venue_tracks")
}

model Hotspot {
  id          String     @id @default(uuid()) @db.Uuid
  venueId     String     @map("venue_id") @db.Uuid
  trackId     String     @map("track_id") @db.Uuid
  tenantId    String     @map("tenant_id") @db.Uuid
  title       String
  payloadJson Json       @default("{}") @map("payload_json")
  sortOrder   Int        @default(0) @map("sort_order")
  venue       Venue      @relation(fields: [venueId], references: [id], onDelete: Cascade)
  track       VenueTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@map("hotspots")
}

model Tour {
  id        String     @id @default(uuid()) @db.Uuid
  venueId   String     @map("venue_id") @db.Uuid
  trackId   String     @map("track_id") @db.Uuid
  tenantId  String     @map("tenant_id") @db.Uuid
  title     String
  stepsJson Json       @default("[]") @map("steps_json")
  venue     Venue      @relation(fields: [venueId], references: [id], onDelete: Cascade)
  track     VenueTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@map("tours")
}
