HOST_PORT=18700
POSTGRES_USER=dtv
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dtv
DATABASE_URL=postgresql://dtv:change-me@saas-db:5432/dtv
STORAGE_ROOT=/data
PUBLIC_BASE_URL=http://127.0.0.1:18700
NODE_ENV=production
SESSION_COOKIE_NAME=dtv_session
# AI 出模：密钥加密（32-byte base64；openssl rand -base64 32）
CREDENTIALS_ENCRYPTION_KEY=
# 单测/CI 默认 mock；生产可留空或 0
MOCK_LLM=1
MOCK_MESH=1
# COS 预留（可空）
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=
